{
  "name": "coronium-proxy-mcp",
  "version": "2.2.0",
  "mcpName": "io.github.coroniumio/coronium-proxy-mcp",
  "description": "Model Context Protocol server for Coronium.io dedicated 4G/5G mobile proxies: list, test, rotate and replace proxies, compare plans and stock, check balances and open support tickets.",
  "private": false,
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "coronium-proxy-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "npm run clean && tsc -p .",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "test:package": "node scripts/package-smoke.mjs",
    "docs:generate": "node scripts/tool-catalog.mjs",
    "docs:check": "node scripts/tool-catalog.mjs --check",
    "test:public": "node scripts/public-smoke.mjs",
    "check:plugins": "node scripts/check-plugins.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coronium",
    "proxy",
    "mobile-proxy",
    "4g-proxy",
    "5g-proxy",
    "authentication",
    "api",
    "claude",
    "ai-assistant"
  ],
  "author": "Coronium.io",
  "license": "MIT",
  "homepage": "https://github.com/coroniumio/coronium-proxy-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coroniumio/coronium-proxy-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/coroniumio/coronium-proxy-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "axios": "1.20.0",
    "dotenv": "17.4.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.11",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    ".env.example",
    "tsconfig.json",
    "CHANGELOG.md",
    "llms.txt",
    "docs",
    "server.json"
  ]
}
