# Authenticate with the dashboard API token. Keep real values out of source control.
# CORONIUM_API_TOKEN=your-customer-token
# CORONIUM_API_KEY=your-customer-token

# Older login from the environment. Prefer the token.
# CORONIUM_LOGIN=your-email@example.com
# CORONIUM_PASSWORD=your-password

# Tool profile: buyer, directory, full (default) or read-only.
# CORONIUM_TOOL_PROFILE=buyer

# Spending and refund tools (full and buyer profiles). Off unless set.
# This, CORONIUM_ENABLE_LOGIN_TOOL and CORONIUM_BASE_URL are ignored in a working-directory .env; set them
# in the MCP host's environment or in the file named by DOTENV_CONFIG_PATH.
# CORONIUM_ENABLE_SPENDING=1

# Legacy alias for CORONIUM_TOOL_PROFILE=read-only.
# CORONIUM_READ_ONLY=true

# Register the coronium_login and coronium_logout tools (full and read-only only). Off unless set.
# CORONIUM_ENABLE_LOGIN_TOOL=1

# Disable automatic login/refresh from CORONIUM_LOGIN and CORONIUM_PASSWORD.
# CORONIUM_AUTO_LOGIN=0

# Optional persisted login token: use a strong secret; otherwise memory only.
# TOKEN_ENCRYPTION_KEY=your-private-encryption-secret

# Default production API; overrides require HTTPS except loopback tests.
# CORONIUM_BASE_URL=https://api.coronium.io/api/v3
# DOTENV_CONFIG_PATH=/absolute/private/path/coronium.env
