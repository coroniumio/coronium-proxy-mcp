# Use one authentication method. Keep real values out of source control.
# CORONIUM_API_TOKEN=your-customer-token
# CORONIUM_API_KEY=your-customer-token
# CORONIUM_LOGIN=your-email@example.com
# CORONIUM_PASSWORD=your-password

# Optional strict inspection mode (also excludes wallet creation/usage refresh).
# CORONIUM_READ_ONLY=true

# Disable automatic login/refresh. Explicit coronium_login remains available.
# CORONIUM_AUTO_LOGIN=0

# Optional persisted login token: use a strong secret; otherwise memory only.
# TOKEN_ENCRYPTION_KEY=your-private-encryption-secret

# Default production API; overrides require HTTPS except loopback tests.
# CORONIUM_BASE_URL=https://api.coronium.io/api/v3
# DOTENV_CONFIG_PATH=/absolute/private/path/coronium.env
