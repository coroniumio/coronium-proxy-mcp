{
  "mcpServers": {
    "coronium": {
      "command": "npx",
      "args": [
        "-y",
        "coronium-proxy-mcp@2.3.0"
      ],
      "env": {
        "CORONIUM_API_TOKEN": "${user_config.api_token}",
        "CORONIUM_TOOL_PROFILE": "directory",
        "CORONIUM_BASE_URL": "https://api.coronium.io/api/v3",
        "CORONIUM_AUTO_LOGIN": "0"
      }
    },
    "coronium-remote": {
      "type": "http",
      "url": "https://api.coronium.io/mcp"
    }
  }
}
